#!/bin/bash
# Stands in for Claude Code in the Runtime contract suite. As far as the Runtime can tell,
# `claude auth login` behaves like the real one: it prints a sign-in link, waits for a code typed
# in its terminal after a prompt that does not end its line, and a non-empty code writes the
# credentials file into the Claude config.
# It also reports its terminal size, so the suite sees resizes arrive.
# The in-memory fake Runtime (dockyard.runtime.fake) simulates exactly this program.
set -u
if [ "$*" != "auth login" ]; then
  echo "stand-in claude: unsupported: $*" >&2
  exit 2
fi
echo "Opening browser to sign in…"
echo "If the browser didn't open, visit: https://claude.com/cai/oauth/authorize?stand-in=1"
printf 'Paste code here if prompted > '
IFS= read -r code
echo "Terminal size: $(stty size)"
if [ -z "$code" ]; then
  echo "Login failed: no code."
  exit 1
fi
umask 077
printf '{"claudeAiOauth":{"accessToken":"%s"}}\n' "$code" > "$CLAUDE_CONFIG_DIR/.credentials.json"
echo "Login successful."
