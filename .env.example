# Instance configuration. Copy to .env next to compose.yaml and fill in.
# Dockyard refuses to start until every required value is set.

# Required. Encrypts Git Credentials at rest. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
DOCKYARD_SECRET_KEY=

# Required. The first Administrator: they can sign in as soon as Dockyard starts.
DOCKYARD_FIRST_ADMINISTRATOR_EMAIL=

# Required. The Cloudflare Access application in front of Dockyard.
# Team name: the "acme" in acme.cloudflareaccess.com.
DOCKYARD_CF_ACCESS_TEAM=
# Application Audience (AUD) tag of that Access application.
DOCKYARD_CF_ACCESS_AUD=

# Port on 127.0.0.1 where the authentication proxy reaches Dockyard.
DOCKYARD_PORT=8000

# Optional. The Base Image that login environments and Projects run (default: the one compose.yaml
# builds from images/base).
# DOCKYARD_BASE_IMAGE=dockyard-base:latest
